{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.levantolabs/levanto",
  "title": "Levanto Sage",
  "description": "Typed decisions (yes/no, choice, score, order, tags) and field extraction from Levanto Sage.",
  "websiteUrl": "https://docs.levanto.ai/integrations/mcp",
  "repository": {
    "url": "https://github.com/levantolabs/levanto-cli",
    "source": "github"
  },
  "version": "1.3.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "levanto",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "LEVANTO_API_KEY",
          "description": "Your Levanto API key (lv_live_...), from https://platform.levanto.ai",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
